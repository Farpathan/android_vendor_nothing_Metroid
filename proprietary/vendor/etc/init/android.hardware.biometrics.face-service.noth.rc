service vendor.face-noth /vendor/bin/hw/android.hardware.biometrics.face-service.noth
    class hal
    user system
    group camera system
    interface aidl android.hardware.biometrics.face.IFace/default
    interface aidl android.hardware.biometrics.face.IFace/default
    ioprio rt 4
    task_profiles CameraServiceCapacity HighPerformance
    rlimit rtprio 10 10
    capabilities SYS_NICE
