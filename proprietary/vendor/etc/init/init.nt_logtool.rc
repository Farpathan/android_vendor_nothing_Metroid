on boot
    write dev/kmsg "reset persist.sys.mdlog.qdss_enable on boot phase"
    setprop persist.sys.mdlog.qdss_enable 0

# sandro.wan@network, add for user build support audio qdss logging
# charles.tang@network, applicable the qdss logging configuration for userdebug also
on property:vendor.all.modules.ready=1
    chown system system /sys/bus/coresight/devices/coresight-stm/enable_source
    chmod 660 /sys/bus/coresight/devices/coresight-stm/enable_source
    mkdir /config/stp-policy/coresight-stm:p_ost.policy 0660 root root
    mkdir /config/stp-policy/coresight-stm:p_ost.policy/default 0660 root root
    write /sys/bus/coresight/devices/coresight-stm/traceid 0x10
    # from init.qti.kernel.debug-volcano.sh#enable_stm_events
    write /sys/bus/coresight/devices/coresight-tmc-etr/buffer_size 0x2000000
    write /sys/bus/coresight/devices/coresight-tmc-etr/enable_sink 1
    write /sys/class/stm_source/ftrace/stm_source_link none
    write /sys/bus/coresight/devices/coresight-stm/enable_source 1
    write /sys/bus/coresight/devices/coresight-stm/hwevent_enable 0

# sandro.wan@network, add for cpumonitor
on property:persist.sys.ntcpumonitor.enable=*
   write dev/kmsg "update ntcpumonitor enable"
   write /proc/cpu_monitor/enable_monitor ${persist.sys.ntcpumonitor.enable}

#porting qxdm logmask
on property:persist.sys.mdlog.enable=0
    write dev/kmsg "stop diag_mdlog"
    start diag_mdlog_stop

service diag_modem_start /system/vendor/bin/diag_mdlog -f /vendor/etc/Diag.cfg -u -o /data/vendor/diag_mdlog -s ${persist.vendor.qcom.mdlog.size:-250} -n ${persist.vendor.qcom.mdlog.num:-15} -c -i
    class late_start
    user shell
    group system oem_2901 sdcard_rw sdcard_r media_rw oem_2905
    disabled
    oneshot

service diag_qdss_modem_start /system/vendor/bin/diag_mdlog -f /vendor/etc/Diag.cfg -q 2 -u -o /data/vendor/diag_mdlog -s ${persist.vendor.qcom.mdlog.size:-250} -n ${persist.vendor.qcom.mdlog.num:-15} -c -i
    class late_start
    user shell
    group system oem_2901 sdcard_rw sdcard_r media_rw oem_2902 oem_2905
    disabled
    oneshot

 on property:persist.sys.mdlog.enable=1
    write dev/kmsg "start modem mdlog"
    start diag_modem_start

 on property:persist.sys.mdlog.qdss_enable=1 && property:sys.boot_completed=1
    write dev/kmsg "start qdss modem mdlog"
    start diag_qdss_modem_start

service diag_btlog_start /system/vendor/bin/diag_mdlog -f /vendor/etc/Diag_bt.cfg -u -o /data/vendor/diag_mdlog -s 100 -n 15 -c
