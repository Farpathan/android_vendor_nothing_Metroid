        <antibanding>1</antibanding>                        <!--uint类型:开关debanding预览算法，默认为开-->
        <motionLevel>                                       <!--运动等级最多可划分6级，由tuning决定运动等级划分标准及每个等级缩短曝光比例-->
            <level>1</level>                                <!--uint类型:当前运动等级-->
            <motion_speed_start>2</motion_speed_start>      <!--float类型:当前等级的运动速度范围-->
            <motion_speed_end>4</motion_speed_end>
            <factor>1.2</factor>                              <!--float类型:曝光时间缩短n倍-->
        </motionLevel>
        <motionLevel>
            <level>2</level>
            <motion_speed_start>4</motion_speed_start>
