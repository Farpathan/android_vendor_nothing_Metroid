<motion_params>
    <zoom_ratio_stable_count>13</zoom_ratio_stable_count>         <!--uint类型:zoomratio稳定n帧后才开始调整曝光-->
    <max_zoom_ratio>1</max_zoom_ratio>                     <!--float类型:大于此physicalZoomratio则不会调整曝光-->
    <max_gain>300</max_gain>                                <!--float类型:最大gain，曝光调整不得超过该gain值，否则噪点过多-->
    <short_loop>1</short_loop>                              <!--uint类型:从低运动等级到高运动等级，需要命中n次-->
    <long_loop>10</long_loop>                                <!--uint类型:从高运动等级到低运动等级，需要命中n次-->
    <switch_to_60fps_speed>20</switch_to_60fps_speed>       <!--float类型:运动速度大于该值，则预览帧率提高到60fps-->
    <!--gyro曲线拐点：每个拐点必须以角速度幅值递增方式配置，且拐点值不能大于gyroMagThresold-->
    <gyroPoint>
        <gyroMag>2</gyroMag>                              <!--float类型:gyro角速度幅值-->
        <expectSpeed>1</expectSpeed>                        <!--float类型:当画面不运动时，期待输出的motionspeed-->
    </gyroPoint>
    <gyroPoint>
        <gyroMag>3</gyroMag>                              <!--float类型:gyro角速度幅值-->
        <expectSpeed>3</expectSpeed>                      <!--float类型:当画面不运动时，期待输出的motionspeed-->
    </gyroPoint>
    <gyroFactor>10</gyroFactor>                               <!--float类型:假设motionspeed=gyro幅值*gyroFactor-->
    <gyroMagThresold>0</gyroMagThresold>                   <!--float类型:gyro幅值小于该阈值会影响motionspeed-->
    <zoom_ratio_section>
        <zoom_ratio_start>1.0</zoom_ratio_start>            <!--float类型:指定physical zoomratio范围-->
        <zoom_ratio_end>1.2</zoom_ratio_end>
        <addtionFactor>1.0</addtionFactor>                  <!--float类型:曝光最终缩短比例 = trigger factor * addtionFactor-->
    </zoom_ratio_section>
    <zoom_ratio_section>
        <zoom_ratio_start>1.2</zoom_ratio_start>
        <zoom_ratio_end>2.8</zoom_ratio_end>
        <addtionFactor>0.8</addtionFactor>
    </zoom_ratio_section>
    <trigger>
        <lux_start>0</lux_start>                            <!--float类型:指定lux范围-->
        <lux_end>100</lux_end>
        <orig_exptime_start>0</orig_exptime_start>          <!--uint64类型:指定exptime范围-->
        <orig_exptime_end>32000000000</orig_exptime_end>
        <adrc_gain>10</adrc_gain>                           <!--float类型:无人脸时，大于该adrcGain则不进入调整曝光-->
